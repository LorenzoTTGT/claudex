#!/usr/bin/env bash
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/claudex"
CONFIG_FILE="${CLAUDEX_PROXY_CONFIG:-$CONFIG_HOME/cliproxyapi.yaml}"
TOKEN_FILE="${CLAUDEX_TOKEN_FILE:-$CONFIG_HOME/token}"
BASE_URL="${CLAUDEX_BASE_URL:-http://127.0.0.1:8317}"
MODEL="${CLAUDEX_MODEL:-gpt-5.6-terra}"
EFFORT="${CLAUDEX_EFFORT:-high}"
AUTOCOMPACT="${CLAUDEX_AUTOCOMPACT:-220k}"
LUNA_MODEL="${CLAUDEX_LUNA_MODEL:-gpt-5.6-luna}"
SOL_MODEL="${CLAUDEX_SOL_MODEL:-gpt-5.6-sol}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}/claudex"
TERRA_PROMPT_FILE="${CLAUDEX_TERRA_PROMPT_FILE:-$CONFIG_HOME/terra-routing.md}"
LOG_FILE="$CONFIG_HOME/cliproxyapi.log"

usage() {
  cat <<'EOF'
Usage: claudex [terra|luna|sol|sol-review|review-gate|install-hook] [arguments]

  claudex [args...]       Start the permanent Terra coordinator session.
  claudex terra [args...] Explicit Terra session.
  claudex luna <task>     Run a read-only Luna research/data task.
  claudex sol <task>      Run a read-only Sol architecture task.
  claudex sol-review      Review the staged change and save a Sol review receipt.
  claudex review-gate     Check whether staged changes need a matching Sol PASS receipt.
  claudex install-hook    Install the review gate in this repository's pre-commit hook.
EOF
}

if [[ "${1:-}" == "help" || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

find_binary() { command -v "$1" 2>/dev/null || true; }
CLAUDE_BIN="${CLAUDE_BIN:-$(find_binary claude)}"
PROXY_BIN="${CLIPROXYAPI_BIN:-$(find_binary cliproxyapi)}"

[[ -n "$CLAUDE_BIN" ]] || { echo 'Claudex: Claude Code is not installed. Run the Claudex installer again.' >&2; exit 1; }
[[ -n "$PROXY_BIN" ]] || { echo 'Claudex: CLIProxyAPI is not installed. Run the Claudex installer again.' >&2; exit 1; }
[[ -r "$CONFIG_FILE" && -r "$TOKEN_FILE" ]] || { printf 'Claudex: setup is incomplete. Expected %s and %s.\n' "$CONFIG_FILE" "$TOKEN_FILE" >&2; exit 1; }

TOKEN="$(<"$TOKEN_FILE")"
proxy_ready() {
  curl --silent --fail --max-time 2 -H "Authorization: Bearer $TOKEN" "$BASE_URL/v1/models" >/dev/null 2>&1
}
if ! proxy_ready; then
  mkdir -p "$CONFIG_HOME"
  nohup "$PROXY_BIN" -config "$CONFIG_FILE" >>"$LOG_FILE" 2>&1 &
  for _ in {1..30}; do proxy_ready && break; sleep 0.2; done
fi
proxy_ready || { printf 'Claudex: the local proxy did not become ready at %s.\nCheck %s. Another service may already be using port 8317.\n' "$BASE_URL" "$LOG_FILE" >&2; exit 1; }

export ANTHROPIC_BASE_URL="$BASE_URL"
export ANTHROPIC_AUTH_TOKEN="$TOKEN"
export ANTHROPIC_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="${CLAUDEX_OPUS_MODEL:-$SOL_MODEL}"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${CLAUDEX_SONNET_MODEL:-$MODEL}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="${CLAUDEX_HAIKU_MODEL:-gpt-5.6-luna}"

claude_command() {
  if [[ "${CLAUDEX_SKIP_PERMISSIONS:-1}" == "1" ]]; then "$CLAUDE_BIN" --dangerously-skip-permissions "$@"; else "$CLAUDE_BIN" "$@"; fi
}
run_terra() {
  [[ -r "$TERRA_PROMPT_FILE" ]] || { echo "Claudex: routing prompt is missing at $TERRA_PROMPT_FILE. Run the Claudex installer again." >&2; exit 1; }
  claude_command --append-system-prompt "$(<"$TERRA_PROMPT_FILE")" --model "$MODEL" --effort "$EFFORT" --autocompact "$AUTOCOMPACT" "$@"
}
run_luna() {
  [[ $# -gt 0 ]] || { echo 'Claudex: luna requires a task prompt.' >&2; exit 2; }
  claude_command --agent claudex-luna --model "$LUNA_MODEL" --effort high --permission-mode plan --autocompact "$AUTOCOMPACT" "$@"
}
run_sol() {
  [[ $# -gt 0 ]] || { echo 'Claudex: sol requires a task prompt.' >&2; exit 2; }
  claude_command --agent claudex-sol --model "$SOL_MODEL" --effort high --permission-mode plan --autocompact "$AUTOCOMPACT" "$@"
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
sol_review_cleanup() {
  local worktree_dir="${1:-}" review_path="${2:-}" diff_path="${3:-}"
  if [[ -n "$worktree_dir" && -d "$worktree_dir" ]]; then
    git worktree remove --force "$worktree_dir" >/dev/null 2>&1 || rm -rf -- "$worktree_dir"
  fi
  [[ -z "$review_path" ]] || rm -f -- "$review_path"
  [[ -z "$diff_path" ]] || rm -f -- "$diff_path"
}

run_sol_review() {
  git rev-parse --git-dir >/dev/null 2>&1 || { echo 'Claudex: sol-review must run in a Git repository.' >&2; exit 2; }
  local review_file staged_diff_file staged_tree review_worktree_dir review_commit parent_commit current_tree prompt receipt verdict cleanup_command
  mkdir -p "$STATE_HOME/tmp"
  review_file="$(mktemp "$STATE_HOME/tmp/sol-review.XXXXXX.json")"
  staged_diff_file="$(mktemp "$STATE_HOME/tmp/sol-staged-diff.XXXXXX.patch")"
  review_worktree_dir=""
  printf -v cleanup_command 'sol_review_cleanup %q %q %q' "$review_worktree_dir" "$review_file" "$staged_diff_file"
  trap "$cleanup_command" EXIT
  staged_tree="$(git write-tree)"
  git diff --cached --no-ext-diff --no-textconv >"$staged_diff_file"
  review_worktree_dir="$(mktemp -d "${TMPDIR:-/tmp}/claudex-sol-review.XXXXXX")"
  printf -v cleanup_command 'sol_review_cleanup %q %q %q' "$review_worktree_dir" "$review_file" "$staged_diff_file"
  trap "$cleanup_command" EXIT
  if parent_commit="$(git rev-parse --verify HEAD 2>/dev/null)"; then
    review_commit="$(printf 'Claudex Sol review snapshot\n' | git commit-tree "$staged_tree" -p "$parent_commit")"
  else
    review_commit="$(printf 'Claudex Sol review snapshot\n' | git commit-tree "$staged_tree")"
  fi
  git worktree add --detach --quiet "$review_worktree_dir" "$review_commit" >/dev/null
  prompt="Review only the exact staged Git diff stored at $staged_diff_file for staged tree $staged_tree. Read that patch first, then inspect relevant repository files with read-only tools. Ignore unstaged and untracked changes. Return only valid JSON with this exact shape: {\"verdict\":\"PASS|CHANGES_REQUIRED|BLOCKED\",\"summary\":\"...\",\"findings\":[{\"severity\":\"high|medium|low\",\"file\":\"path or null\",\"line\":1,\"problem\":\"...\",\"failure_scenario\":\"...\",\"required_action\":\"... or null\"}],\"uncertainties\":[\"...\"]}. Use PASS only when no material correction is required."
  (cd "$review_worktree_dir" && claude_command --agent claudex-sol --model "$SOL_MODEL" --effort high --permission-mode plan --autocompact "$AUTOCOMPACT" --print --output-format text "$prompt") >"$review_file"
  current_tree="$(git write-tree)"
  if [[ "$current_tree" != "$staged_tree" ]]; then
    echo 'Claudex: staged tree changed while Sol was reviewing; no receipt was saved. Run claudex sol-review again.' >&2
    sol_review_cleanup "$review_worktree_dir" "$review_file" "$staged_diff_file"
    trap - EXIT
    return 1
  fi
  verdict="$(python3 - "$review_file" <<'PY'
import json, sys
print(json.load(open(sys.argv[1])).get('verdict', ''))
PY
)"
  if [[ "$verdict" != "PASS" ]]; then
    echo "Claudex: Sol review verdict is ${verdict:-invalid}; no approval receipt was saved." >&2
    sol_review_cleanup "$review_worktree_dir" "$review_file" "$staged_diff_file"
    trap - EXIT
    return 1
  fi
  receipt="$("$SCRIPT_DIR/claudex-review-receipt" _finalize "$review_file" "$staged_tree")"
  if [[ ! -r "$receipt" ]]; then
    echo 'Claudex: verification completed but no receipt was created.' >&2
    sol_review_cleanup "$review_worktree_dir" "$review_file" "$staged_diff_file"
    trap - EXIT
    return 1
  fi
  sol_review_cleanup "$review_worktree_dir" "$review_file" "$staged_diff_file"
  trap - EXIT
  echo 'Claudex: Sol PASS receipt with staged verification evidence saved for the current staged tree.'
}
install_hook() {
  local hook_dir hook_file
  hook_dir="$(git rev-parse --git-path hooks)" || { echo 'Claudex: install-hook must run in a Git repository.' >&2; exit 2; }
  mkdir -p "$hook_dir"
  hook_file="$hook_dir/pre-commit"
  python3 - "$SCRIPT_DIR/../hooks/pre-commit" "$hook_file" "$SCRIPT_DIR/claudex-review-receipt" <<'PY'
import pathlib, sys

template, destination, gate = sys.argv[1:]
content = pathlib.Path(template).read_text().replace("__CLAUDEX_GATE_BIN__", gate)
pathlib.Path(destination).write_text(content)
PY
  chmod 755 "$hook_file"
  echo "Claudex: installed review gate at $hook_file"
}

case "${1:-}" in
  luna) shift; run_luna "$@" ;;
  sol) shift; run_sol "$@" ;;
  sol-review) shift; [[ $# -eq 0 ]] || { usage >&2; exit 2; }; run_sol_review ;;
  review-gate) shift; [[ $# -eq 0 ]] || { usage >&2; exit 2; }; exec "$SCRIPT_DIR/claudex-review-receipt" check ;;
  install-hook) shift; [[ $# -eq 0 ]] || { usage >&2; exit 2; }; install_hook ;;
  terra) shift; run_terra "$@" ;;
  *) run_terra "$@" ;;
esac
