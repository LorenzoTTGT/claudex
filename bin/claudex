#!/usr/bin/env bash
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/claudex"
CONFIG_FILE="${CLAUDEX_PROXY_CONFIG:-$CONFIG_HOME/cliproxyapi.yaml}"
TOKEN_FILE="${CLAUDEX_TOKEN_FILE:-$CONFIG_HOME/token}"
BASE_URL="${CLAUDEX_BASE_URL:-http://127.0.0.1:8317}"
MODEL="${CLAUDEX_MODEL:-gpt-5.5}"
EFFORT="${CLAUDEX_EFFORT:-low}"
AUTOCOMPACT="${CLAUDEX_AUTOCOMPACT:-220k}"
LUNA_MODEL="${CLAUDEX_LUNA_MODEL:-gpt-5.6-luna}"
SOL_MODEL="${CLAUDEX_SOL_MODEL:-gpt-5.6-sol}"
FRONTEND_MODEL="gpt-5.6-terra"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}/claudex"
TERRA_PROMPT_FILE="${CLAUDEX_TERRA_PROMPT_FILE:-$CONFIG_HOME/terra-routing.md}"
LOG_FILE="$CONFIG_HOME/cliproxyapi.log"
TELEMETRY_ENABLED="${CLAUDEX_TELEMETRY:-0}"
TELEMETRY_DIR="$STATE_HOME/telemetry"
TELEMETRY_FILE="$TELEMETRY_DIR/events.jsonl"
TELEMETRY_REVISION=2
TELEMETRY_INVOCATION_ID=""
TELEMETRY_MODE="terra"
TELEMETRY_ROUTE="terra"
TELEMETRY_EFFORT="medium"
TELEMETRY_AUTOCOMPACT="220k"
TELEMETRY_PROXY_STARTED=0
TELEMETRY_PROXY_READY=0
TELEMETRY_PROXY_PROBES=0
TELEMETRY_SOL_VERDICT=""
TELEMETRY_RECEIPT_STATUS=""

usage() {
  cat <<'EOF'
Usage: claudex [terra|luna|sol|frontend|sol-review|review-gate|install-hook] [arguments]

  claudex [args...]       Start the GPT-5.5 coordinator session.
  claudex terra [args...] Backward-compatible coordinator alias.
  claudex luna <task>     Run a read-only Luna research/data task.
  claudex sol <task>      Run a medium-effort read-only Sol architecture advisory.
  claudex frontend <task> Run a high-effort bounded Terra frontend implementation task.
  claudex sol-review      Run a medium-effort staged-change Sol Review and save a receipt.
  claudex review-gate     Check whether staged changes need a matching Sol PASS receipt.
  claudex install-hook    Install the review gate in this repository's pre-commit hook.
EOF
}

if [[ "${1:-}" == "help" || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

reject_xhigh() {
  [[ "$EFFORT" != "xhigh" ]] || { echo 'Claudex: xhigh effort is unsupported.' >&2; exit 2; }
  local argument next=""
  for argument in "$@"; do
    [[ "$argument" != "--effort=xhigh" ]] || { echo 'Claudex: xhigh effort is unsupported.' >&2; exit 2; }
    if [[ "$next" == "1" ]]; then
      [[ "$argument" != "xhigh" ]] || { echo 'Claudex: xhigh effort is unsupported.' >&2; exit 2; }
      next=""
      continue
    fi
    [[ "$argument" != "--effort" ]] || next=1
  done
}
reject_xhigh "$@"

reject_role_effort_override() {
  local argument
  for argument in "$@"; do
    case "$argument" in
      --effort|--effort=*)
        echo 'Claudex: role-specific effort is fixed by the selected agent.' >&2
        exit 2
        ;;
    esac
  done
}

reject_frontend_role_override() {
  local argument next=""
  for argument in "$@"; do
    case "$argument" in
      --agent=*|--model=*|--effort=*)
        echo 'Claudex: frontend agent, model, and effort are fixed.' >&2
        exit 2
        ;;
    esac
    if [[ "$next" == "1" ]]; then
      echo 'Claudex: frontend agent, model, and effort are fixed.' >&2
      exit 2
    fi
    case "$argument" in
      --agent|--model|--effort) next=1 ;;
    esac
  done
}
reject_direct_frontend_agent() {
  local argument next=""
  for argument in "$@"; do
    [[ "$argument" != "--agent=claudex-frontend" ]] || { echo 'Claudex: use the frontend command for claudex-frontend.' >&2; exit 2; }
    if [[ "$next" == "1" ]]; then
      [[ "$argument" != "claudex-frontend" ]] || { echo 'Claudex: use the frontend command for claudex-frontend.' >&2; exit 2; }
      next=""
      continue
    fi
    [[ "$argument" != "--agent" ]] || next=1
  done
}
if [[ "${1:-}" == "frontend" ]]; then
  reject_frontend_role_override "${@:2}"
else
  reject_direct_frontend_agent "$@"
fi

effective_terra_effort() {
  local argument value="$EFFORT" next=""
  for argument in "$@"; do
    if [[ "$next" == "1" ]]; then
      value="$argument"
      next=""
      continue
    fi
    case "$argument" in
      --effort) next=1 ;;
      --effort=*) value="${argument#--effort=}" ;;
    esac
  done
  telemetry_effort "$value"
}

telemetry_effort() {
  case "$1" in low|medium|high|max) printf '%s\n' "$1" ;; *) printf 'custom\n' ;; esac
}
telemetry_autocompact() {
  if [[ "$1" == "auto" ]]; then
    printf 'auto\n'
  elif [[ "$1" =~ ^[0-9]+[kK]$ ]]; then
    printf '%sk\n' "${1%?}"
  elif [[ "$1" =~ ^[0-9]+[mM]$ ]]; then
    printf '%sm\n' "${1%?}"
  else
    printf 'custom\n'
  fi
}
telemetry_route() {
  case "$1" in
    gpt-5.6-terra) printf 'terra\n' ;;
    gpt-5.6-luna) printf 'luna\n' ;;
    gpt-5.6-sol) printf 'sol\n' ;;
    gpt-5.5) printf 'gpt-5.5\n' ;;
    *) printf 'custom\n' ;;
  esac
}
telemetry_event() {
  [[ "$TELEMETRY_ENABLED" == "1" && -n "$TELEMETRY_INVOCATION_ID" ]] || return 0
  local event="$1" elapsed_ms="${2:-}" exit_code="${3:-}"
  python3 - "$TELEMETRY_DIR" "$TELEMETRY_FILE" "$TELEMETRY_REVISION" "$event" "$TELEMETRY_INVOCATION_ID" "$TELEMETRY_MODE" "$TELEMETRY_ROUTE" "$TELEMETRY_EFFORT" "$TELEMETRY_AUTOCOMPACT" "$TELEMETRY_PROXY_STARTED" "$TELEMETRY_PROXY_READY" "$TELEMETRY_PROXY_PROBES" "$elapsed_ms" "$exit_code" "$TELEMETRY_SOL_VERDICT" "$TELEMETRY_RECEIPT_STATUS" <<'PY' >/dev/null 2>&1 || true
import datetime
import fcntl
import json
import os
import stat
import sys

(directory, path, revision, event, invocation_id, mode, route, effort, autocompact,
 proxy_started, proxy_ready, proxy_probes, elapsed_ms, exit_code, sol_verdict, receipt_status) = sys.argv[1:]
cap = 5 * 1024 * 1024
nofollow = getattr(os, "O_NOFOLLOW", 0)

def regular(path):
    try:
        value = os.lstat(path)
    except FileNotFoundError:
        return None
    if stat.S_ISLNK(value.st_mode) or not stat.S_ISREG(value.st_mode):
        raise OSError("unsafe telemetry target")
    return value

try:
    directory = os.path.realpath(directory)
    path = os.path.join(directory, os.path.basename(path))
    current = os.path.sep
    for component in directory.split(os.path.sep)[1:]:
        current = os.path.join(current, component)
        try:
            value = os.lstat(current)
            if stat.S_ISLNK(value.st_mode) or not stat.S_ISDIR(value.st_mode):
                raise OSError("unsafe telemetry directory")
        except FileNotFoundError:
            os.mkdir(current, 0o700)
    os.chmod(directory, 0o700)

    lock_path = os.path.join(directory, ".lock")
    regular(lock_path)
    lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR | nofollow, 0o600)
    try:
        os.chmod(lock_path, 0o600)
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (BlockingIOError, OSError):
        os.close(lock_fd)
        raise SystemExit(0)

    try:
        regular(path)
        record = {
            "format": 1,
            "event": event,
            "recorded_at": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"),
            "invocation_id": invocation_id,
            "launcher_revision": int(revision),
            "mode": mode,
            "route": route,
            "effort": effort,
            "autocompact": autocompact,
            "proxy_start_attempted": proxy_started == "1",
            "proxy_ready": proxy_ready == "1",
            "proxy_probes": int(proxy_probes),
            "elapsed_ms": int(elapsed_ms) if elapsed_ms else None,
            "exit_code": int(exit_code) if exit_code else None,
            "sol_review_verdict": sol_verdict or None,
            "receipt_status": receipt_status or None,
        }
        encoded = (json.dumps(record, separators=(",", ":"), sort_keys=True) + "\n").encode()
        if len(encoded) > cap:
            raise OSError("oversized telemetry record")
        try:
            with open(path, "rb") as source:
                existing = source.read()
        except FileNotFoundError:
            existing = b""
        if existing:
            if not existing.endswith(b"\n"):
                raise OSError("malformed telemetry")
            lines = existing.splitlines(keepends=True)
            for line in lines:
                json.loads(line)
            while lines and sum(map(len, lines)) + len(encoded) > cap:
                lines.pop(0)
            existing = b"".join(lines)
        if len(existing) + len(encoded) > cap:
            raise OSError("telemetry cap")
        fd = os.open(path, os.O_CREAT | os.O_WRONLY | os.O_TRUNC | nofollow, 0o600)
        try:
            os.chmod(path, 0o600)
            os.write(fd, existing + encoded)
        finally:
            os.close(fd)
    finally:
        fcntl.flock(lock_fd, fcntl.LOCK_UN)
        os.close(lock_fd)
except Exception:
    pass
PY
}

case "${1:-}" in
  luna) TELEMETRY_MODE="luna"; TELEMETRY_ROUTE="$(telemetry_route "$LUNA_MODEL")"; TELEMETRY_EFFORT="medium" ;;
  sol) TELEMETRY_MODE="sol"; TELEMETRY_ROUTE="$(telemetry_route "$SOL_MODEL")"; TELEMETRY_EFFORT="medium" ;;
  frontend) TELEMETRY_MODE="frontend"; TELEMETRY_ROUTE="frontend"; TELEMETRY_EFFORT="high" ;;
  sol-review) TELEMETRY_MODE="sol-review"; TELEMETRY_ROUTE="$(telemetry_route "$SOL_MODEL")"; TELEMETRY_EFFORT="medium" ;;
  *) TELEMETRY_MODE="terra"; TELEMETRY_ROUTE="$(telemetry_route "$MODEL")"; TELEMETRY_EFFORT="$(effective_terra_effort "$@")" ;;
esac
TELEMETRY_AUTOCOMPACT="$(telemetry_autocompact "$AUTOCOMPACT")"
if [[ "$TELEMETRY_ENABLED" == "1" ]]; then
  TELEMETRY_INVOCATION_ID="$(python3 -c 'import secrets; print(secrets.token_hex(16))' 2>/dev/null || true)"
  [[ -n "$TELEMETRY_INVOCATION_ID" ]] || TELEMETRY_ENABLED=0
fi

find_binary() { command -v "$1" 2>/dev/null || true; }
CLAUDE_BIN="${CLAUDE_BIN:-$(find_binary claude)}"
PROXY_BIN="${CLIPROXYAPI_BIN:-$(find_binary cliproxyapi)}"

[[ -n "$CLAUDE_BIN" ]] || { echo 'Claudex: Claude Code is not installed. Run the Claudex installer again.' >&2; exit 1; }
[[ -n "$PROXY_BIN" ]] || { echo 'Claudex: CLIProxyAPI is not installed. Run the Claudex installer again.' >&2; exit 1; }
[[ -r "$CONFIG_FILE" && -r "$TOKEN_FILE" ]] || { printf 'Claudex: setup is incomplete. Expected %s and %s.\n' "$CONFIG_FILE" "$TOKEN_FILE" >&2; exit 1; }

TOKEN="$(<"$TOKEN_FILE")"
proxy_ready() {
  curl --silent --fail --max-time 2 -H "Authorization: Bearer $TOKEN" "$BASE_URL/v1/models" >/dev/null 2>&1
}
if ! proxy_ready; then
  TELEMETRY_PROXY_STARTED=1
  telemetry_event proxy_start_attempted
  mkdir -p "$CONFIG_HOME"
  nohup "$PROXY_BIN" -config "$CONFIG_FILE" >>"$LOG_FILE" 2>&1 &
  for _ in {1..30}; do
    TELEMETRY_PROXY_PROBES=$((TELEMETRY_PROXY_PROBES + 1))
    proxy_ready && break
    sleep 0.2
  done
fi
if ! proxy_ready; then
  telemetry_event launcher_start_failed
  printf 'Claudex: the local proxy did not become ready at %s.\nCheck %s. Another service may already be using port 8317.\n' "$BASE_URL" "$LOG_FILE" >&2
  exit 1
fi
TELEMETRY_PROXY_READY=1
telemetry_event proxy_ready

export ANTHROPIC_BASE_URL="$BASE_URL"
export ANTHROPIC_AUTH_TOKEN="$TOKEN"
export ANTHROPIC_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="${CLAUDEX_OPUS_MODEL:-$SOL_MODEL}"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${CLAUDEX_SONNET_MODEL:-$MODEL}"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="${CLAUDEX_HAIKU_MODEL:-gpt-5.6-luna}"

claude_command() {
  if [[ "$TELEMETRY_ENABLED" != "1" ]]; then
    if [[ "${CLAUDEX_SKIP_PERMISSIONS:-1}" == "1" ]]; then "$CLAUDE_BIN" --dangerously-skip-permissions "$@"; else "$CLAUDE_BIN" "$@"; fi
    return
  fi
  local started_ns elapsed_ms status
  started_ns="$(python3 -c 'import time; print(time.monotonic_ns())' 2>/dev/null || true)"
  set +e
  if [[ "${CLAUDEX_SKIP_PERMISSIONS:-1}" == "1" ]]; then "$CLAUDE_BIN" --dangerously-skip-permissions "$@"; else "$CLAUDE_BIN" "$@"; fi
  status=$?
  set -e
  if [[ -n "$started_ns" ]]; then
    elapsed_ms="$(python3 - "$started_ns" <<'PY' 2>/dev/null || true
import sys, time
print(max(0, (time.monotonic_ns() - int(sys.argv[1])) // 1_000_000))
PY
)"
  else
    elapsed_ms=""
  fi
  telemetry_event launch_completed "$elapsed_ms" "$status"
  return "$status"
}
run_terra() {
  [[ -r "$TERRA_PROMPT_FILE" ]] || { echo "Claudex: routing prompt is missing at $TERRA_PROMPT_FILE. Run the Claudex installer again." >&2; exit 1; }
  claude_command --append-system-prompt "$(<"$TERRA_PROMPT_FILE")" --model "$MODEL" --effort "$EFFORT" --autocompact "$AUTOCOMPACT" "$@"
}
run_luna() {
  [[ $# -gt 0 ]] || { echo 'Claudex: luna requires a task prompt.' >&2; exit 2; }
  reject_role_effort_override "$@"
  claude_command --agent claudex-luna --model "$LUNA_MODEL" --effort medium --permission-mode plan --autocompact "$AUTOCOMPACT" "$@"
}
run_sol() {
  [[ $# -gt 0 ]] || { echo 'Claudex: sol requires a task prompt.' >&2; exit 2; }
  reject_role_effort_override "$@"
  claude_command --agent claudex-sol --model "$SOL_MODEL" --effort medium --permission-mode plan --autocompact "$AUTOCOMPACT" "$@"
}
run_frontend() {
  [[ $# -gt 0 ]] || { echo 'Claudex: frontend requires a task prompt.' >&2; exit 2; }
  reject_frontend_role_override "$@"
  claude_command --agent claudex-frontend --model "$FRONTEND_MODEL" --effort high --permission-mode default --autocompact "$AUTOCOMPACT" "$@"
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
sol_review_cleanup() {
  local worktree_dir="${1:-}" review_path="${2:-}" diff_path="${3:-}"
  if [[ -n "$worktree_dir" && -d "$worktree_dir" ]]; then
    git worktree remove --force "$worktree_dir" >/dev/null 2>&1 || rm -rf -- "$worktree_dir"
  fi
  [[ -z "$review_path" ]] || rm -f -- "$review_path"
  [[ -z "$diff_path" ]] || rm -f -- "$diff_path"
}

run_sol_review() {
  git rev-parse --git-dir >/dev/null 2>&1 || { echo 'Claudex: sol-review must run in a Git repository.' >&2; exit 2; }
  local review_file staged_diff_file staged_tree review_worktree_dir review_commit parent_commit current_tree prompt receipt verdict cleanup_command
  mkdir -p "$STATE_HOME/tmp"
  review_file="$(mktemp "$STATE_HOME/tmp/sol-review.XXXXXX.json")"
  staged_diff_file="$(mktemp "$STATE_HOME/tmp/sol-staged-diff.XXXXXX.patch")"
  review_worktree_dir=""
  printf -v cleanup_command 'sol_review_cleanup %q %q %q' "$review_worktree_dir" "$review_file" "$staged_diff_file"
  trap "$cleanup_command" EXIT
  staged_tree="$(git write-tree)"
  git diff --cached --no-ext-diff --no-textconv >"$staged_diff_file"
  review_worktree_dir="$(mktemp -d "${TMPDIR:-/tmp}/claudex-sol-review.XXXXXX")"
  printf -v cleanup_command 'sol_review_cleanup %q %q %q' "$review_worktree_dir" "$review_file" "$staged_diff_file"
  trap "$cleanup_command" EXIT
  if parent_commit="$(git rev-parse --verify HEAD 2>/dev/null)"; then
    review_commit="$(printf 'Claudex Sol review snapshot\n' | git commit-tree "$staged_tree" -p "$parent_commit")"
  else
    review_commit="$(printf 'Claudex Sol review snapshot\n' | git commit-tree "$staged_tree")"
  fi
  git worktree add --detach --quiet "$review_worktree_dir" "$review_commit" >/dev/null
  prompt="Review only the exact staged Git diff stored at $staged_diff_file for staged tree $staged_tree. Read that patch first, then inspect relevant repository files with read-only tools. Ignore unstaged and untracked changes. Before evaluating findings, state the intended behavior inferred from the staged change, tests, documentation, and surrounding code. If the intent cannot be established reliably, return BLOCKED. Review whether the diff achieves that intent rather than applying generic stylistic preferences. Prefer runtime evidence over configuration or unverified claims, and flag workaround layers that mask symptoms instead of fixing an established root cause. Do not let feedback expand the change beyond its inferred intent; unrelated improvements are out of scope. Flag speculative abstractions, fallback paths, future-proofing, or compatibility layers without a concrete current requirement. Classify every finding under exactly one axis: Behavior/Spec for missing, incorrect, partial, or unrequested behavior; Repository Standards only for violations supported by repository instructions, existing local patterns, or configured tooling. Do not invent generic standards. Return only valid JSON with this exact shape: {\"verdict\":\"PASS|CHANGES_REQUIRED|BLOCKED\",\"intent\":\"...\",\"summary\":\"...\",\"findings\":[{\"axis\":\"Behavior/Spec|Repository Standards\",\"severity\":\"high|medium|low\",\"file\":\"path or null\",\"line\":1,\"problem\":\"...\",\"failure_scenario\":\"...\",\"required_action\":\"... or null\"}],\"uncertainties\":[\"...\"]}. Use PASS only when no material correction is required."
  (cd "$review_worktree_dir" && claude_command --agent claudex-sol-review --model "$SOL_MODEL" --effort medium --permission-mode plan --autocompact "$AUTOCOMPACT" --print --output-format text "$prompt") >"$review_file"
  current_tree="$(git write-tree)"
  if [[ "$current_tree" != "$staged_tree" ]]; then
    TELEMETRY_SOL_VERDICT=invalid
    TELEMETRY_RECEIPT_STATUS=not_attempted
    telemetry_event sol_review_completed
    echo 'Claudex: staged tree changed while Sol was reviewing; no receipt was saved. Run claudex sol-review again.' >&2
    sol_review_cleanup "$review_worktree_dir" "$review_file" "$staged_diff_file"
    trap - EXIT
    return 1
  fi
  verdict="$(python3 - "$review_file" <<'PY'
import json, sys
print(json.load(open(sys.argv[1])).get('verdict', ''))
PY
)"
  if [[ "$verdict" != "PASS" ]]; then
    case "$verdict" in CHANGES_REQUIRED|BLOCKED) TELEMETRY_SOL_VERDICT="$verdict" ;; *) TELEMETRY_SOL_VERDICT=invalid ;; esac
    TELEMETRY_RECEIPT_STATUS=not_created
    telemetry_event sol_review_completed
    echo "Claudex: Sol review verdict is ${verdict:-invalid}; no approval receipt was saved." >&2
    sol_review_cleanup "$review_worktree_dir" "$review_file" "$staged_diff_file"
    trap - EXIT
    return 1
  fi
  receipt="$("$SCRIPT_DIR/claudex-review-receipt" _finalize "$review_file" "$staged_tree")"
  if [[ ! -r "$receipt" ]]; then
    TELEMETRY_SOL_VERDICT=PASS
    TELEMETRY_RECEIPT_STATUS=not_created
    telemetry_event sol_review_completed
    echo 'Claudex: verification completed but no receipt was created.' >&2
    sol_review_cleanup "$review_worktree_dir" "$review_file" "$staged_diff_file"
    trap - EXIT
    return 1
  fi
  sol_review_cleanup "$review_worktree_dir" "$review_file" "$staged_diff_file"
  trap - EXIT
  TELEMETRY_SOL_VERDICT=PASS
  TELEMETRY_RECEIPT_STATUS=created
  telemetry_event sol_review_completed
  echo 'Claudex: Sol PASS receipt with staged verification evidence saved for the current staged tree.'
}
install_hook() {
  local hook_dir hook_file
  hook_dir="$(git rev-parse --git-path hooks)" || { echo 'Claudex: install-hook must run in a Git repository.' >&2; exit 2; }
  mkdir -p "$hook_dir"
  hook_file="$hook_dir/pre-commit"
  python3 - "$SCRIPT_DIR/../hooks/pre-commit" "$hook_file" "$SCRIPT_DIR/claudex-review-receipt" <<'PY'
import pathlib, sys

template, destination, gate = sys.argv[1:]
content = pathlib.Path(template).read_text().replace("__CLAUDEX_GATE_BIN__", gate)
pathlib.Path(destination).write_text(content)
PY
  chmod 755 "$hook_file"
  echo "Claudex: installed review gate at $hook_file"
}

case "${1:-}" in
  luna) shift; run_luna "$@" ;;
  sol) shift; run_sol "$@" ;;
  frontend) shift; run_frontend "$@" ;;
  sol-review) shift; [[ $# -eq 0 ]] || { usage >&2; exit 2; }; run_sol_review ;;
  review-gate) shift; [[ $# -eq 0 ]] || { usage >&2; exit 2; }; exec "$SCRIPT_DIR/claudex-review-receipt" check ;;
  install-hook) shift; [[ $# -eq 0 ]] || { usage >&2; exit 2; }; install_hook ;;
  terra) shift; run_terra "$@" ;;
  *) run_terra "$@" ;;
esac
