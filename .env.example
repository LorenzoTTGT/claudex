# Optional Claudex overrides
CLAUDEX_MODEL=gpt-5.6-terra
# Supported efforts: low, medium, high, or max. Claudex rejects xhigh.
CLAUDEX_EFFORT=high
CLAUDEX_OPUS_MODEL=gpt-5.6-sol
CLAUDEX_HAIKU_MODEL=gpt-5.6-luna
CLAUDEX_LUNA_MODEL=gpt-5.6-luna
CLAUDEX_SOL_MODEL=gpt-5.6-sol
# Frontend implementation uses the fixed gpt-5.5 / high route; no override is supported.
CLAUDEX_AUTOCOMPACT=220k

# Opt-in, local-only, content-free launcher telemetry. No data is sent over the network.
# CLAUDEX_TELEMETRY=1
CLAUDEX_TERRA_PROMPT_FILE=$HOME/.config/claudex/terra-routing.md
CLAUDEX_BASE_URL=http://127.0.0.1:8317

# Claudex defaults to bypassing permission prompts. Set to 0 to re-enable them.
CLAUDEX_SKIP_PERMISSIONS=1
